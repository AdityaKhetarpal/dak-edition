---
import '@fontsource/unifrakturcook/700.css';
import '@fontsource/im-fell-double-pica/400.css';
import '@fontsource/im-fell-double-pica/400-italic.css';
import '@fontsource/old-standard-tt/400.css';
import '@fontsource/old-standard-tt/400-italic.css';
import '@fontsource/old-standard-tt/700.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import 'lenis/dist/lenis.css';
import '../styles/sheet.css';
import { SECTIONS, edition, longDate } from '../lib/edition.js';

const { title, current, feed, pageCount } = Astro.props;

const pageTitle = title ? `${title} | The Dak Edition` : 'The Dak Edition';
const dateLine = longDate(edition.editionDate);
---

<!doctype html>
<html lang="en-IN" data-edition={edition.editionDate}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="Every morning's Indian newspapers, on one sheet." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#100e1f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="The Dak Edition" href="/rss.xml" />
    {feed && <link rel="alternate" type="application/rss+xml" title={`${title} | The Dak Edition`} href={feed} />}
    <script is:inline>
      // The print run plays once a visit. If the script never arrives, the page
      // shows itself after two seconds rather than staying blank.
      (function () {
        try {
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (calm || location.pathname !== '/' || sessionStorage.getItem('dak-printed')) return;
          var root = document.documentElement;
          root.classList.add('press-run');
          setTimeout(function () { root.classList.remove('press-run'); }, 2000);
        } catch (error) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#edition">Skip to the stories</a>
    <div id="desk" aria-hidden="true"></div>
    <canvas id="gold-dust" aria-hidden="true"></canvas>
    <div class="candle" aria-hidden="true"></div>
    <div class="reading-rule" aria-hidden="true"></div>

    <div class="running-head" aria-hidden="true">
      <a class="running-title" href="/" tabindex="-1">The Dak Edition</a>
      <span class="running-date">{dateLine}</span>
      <nav class="running-nav">
        <a href="/talking-points/" tabindex="-1">Talking points</a>
        {SECTIONS.map((section) => (
          <a href={`/section/${section.id}/`} tabindex="-1">{section.id === 'opinion' ? 'Opinion' : section.name}</a>
        ))}
      </nav>
    </div>

    <p class="late-notice" id="late-notice" hidden>
      This is the {dateLine} edition. Today&rsquo;s has not been filed yet.
    </p>

    <main class="edition" id="edition" data-current={current}>
      <slot />
    </main>

    {pageCount && (
      <nav class="page-tab" aria-label="Turn the page">
        <button type="button" data-turn="-1" aria-label="Previous page">&lsaquo;</button>
        <span><span id="page-now">Page 1</span> of {pageCount}</span>
        <button type="button" data-turn="1" aria-label="Next page">&rsaquo;</button>
      </nav>
    )}

    <script>
      import '../scripts/press.js';
    </script>

    <script is:inline>
      (function () {
        var now = new Date();
        var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(now);
        var hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', hour12: false }).format(now));
        if (document.documentElement.dataset.edition < today && hour >= 9) {
          document.getElementById('late-notice').hidden = false;
        }
      })();
    </script>
  </body>
</html>
