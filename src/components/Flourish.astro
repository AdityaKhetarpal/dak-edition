---
// A gold vine for each corner of the sheet, in the manner of an illuminated
// manuscript's border. One drawing, flipped into place with CSS.
---

{['top-left', 'top-right', 'bottom-left', 'bottom-right'].map((corner) => (
  <svg class={`flourish flourish-${corner}`} viewBox="0 0 90 90" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M6 86V26C6 13 13 6 26 6h60" />
      <path d="M14 70V32c0-11 7-18 18-18h38" />
      <path d="M14 34c9 0 15 6 15 14 0 6-4 10-9 10s-8-3-8-7 3-6 6-6" />
      <path d="M34 14c0 9 6 15 14 15 6 0 10-4 10-9s-3-8-7-8-6 3-6 6" />
    </g>
    <g fill="currentColor">
      <circle cx="6" cy="6" r="3.2" />
      <path d="M26 26c9-1 15-7 16-16-9 1-15 7-16 16Z" />
      <path d="M26 26c1 9 7 15 16 16-1-9-7-15-16-16Z" opacity="0.7" />
    </g>
  </svg>
))}
